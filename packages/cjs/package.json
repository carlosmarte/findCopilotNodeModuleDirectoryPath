{
  "name": "@findcopilot/cjs",
  "version": "1.0.0",
  "description": "CommonJS resolver for the closest installed @github/copilot* module (require.resolve + manual node_modules walk).",
  "license": "MIT",
  "author": "Carlos Marte",
  "type": "commonjs",
  "main": "./src/index.cjs",
  "exports": {
    ".": "./src/index.cjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "find-copilot-cjs": "./bin/find.cjs"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "copilot",
    "resolve",
    "require.resolve",
    "node_modules",
    "commonjs",
    "cjs"
  ],
  "engines": {
    "node": ">=18.17"
  }
}
